generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String           @unique
  name         String
  passwordHash String
  avatar       String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  sessions     Session[]
  inventory    InventoryListing[]
  apps         UserApp[]
}

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  jwtId     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sess_user")

  @@index([userId], map: "idx_sess_user")
}

model InventoryListing {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @db.Uuid
  appId      String   @db.Uuid
  vin        String
  year       Int
  make       String
  model      String
  trim       String?
  bodyStyle  String?  @map("body_style")
  drivetrain String?
  msrp       Decimal? @db.Decimal(10, 2)
  price      Decimal? @db.Decimal(10, 2)
  mileage    Int      @default(0)
  status     String   @default("available")
  scrapedAt  DateTime @default(now()) @map("scraped_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inv_user")
  app        UserApp  @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inv_app")

  @@unique([userId, vin], map: "u_inv_user_vin")
  @@index([userId], map: "idx_inv_user")
  @@index([appId], map: "idx_inv_app")
  @@index([make, model], map: "idx_inv_make_model")
  @@map("inventory_listings")
}

model UserApp {
  id                    String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String             @db.Uuid
  name                  String
  description           String?
  fortellisClientId     String             @map("fortellis_client_id")
  fortellisClientSecret String?            @map("fortellis_client_secret")
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_app_user")
  inventory             InventoryListing[]

  @@index([userId], map: "idx_app_user")
  @@map("user_apps")
}
