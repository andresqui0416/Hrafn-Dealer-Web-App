model SaleDealEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  saleDataId String  @db.Uuid
  
  // Special contract fields
  specialContract1Date   DateTime? @db.Date
  specialContract1Reason String?
  specialContract2Date   DateTime? @db.Date
  specialContract2Reason String?
  
  // Event fields (for events array)
  dealEvent      String?
  dealEventDate  DateTime? @db.Date
  eventOrder     Int? // Order in the events array (1-10)
  
  saleData       SaleData @relation(fields: [saleDataId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_event_sale")
  
  @@index([saleDataId], map: "idx_sale_event_sale")
  @@map("SaleDealEvent")
}

model SaleFee {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  saleDataId String  @db.Uuid
  
  feeType   String   // "addToCapCostFee", "annualFee", "feeOption", "initialFee", "addToPriceFeeName"
  amount    Decimal? @db.Decimal(12, 2)
  name      String?
  costAmount Decimal? @db.Decimal(12, 2)
  profitType String?
  flag      Boolean?
  orderIndex Int? // Order in the array
  
  saleData  SaleData @relation(fields: [saleDataId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_fee_sale")
  
  @@index([saleDataId], map: "idx_sale_fee_sale")
  @@index([feeType], map: "idx_sale_fee_type")
  @@map("SaleFee")
}

model SaleIncentive {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  saleDataId String  @unique @db.Uuid
  
  incentiveDealer   Decimal? @db.Decimal(12, 2)
  incentiveProgram  Decimal? @db.Decimal(12, 2)
  rebateAmount      Decimal? @db.Decimal(12, 2)
  
  // Common rebate details stored as JSON array
  commonRebateDetails Json? // Array of {id, amount, code, description}
  
  saleData          SaleData @relation(fields: [saleDataId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_inc_sale")
  
  @@map("SaleIncentive")
}

model SaleInsurance {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  saleDataId String  @unique @db.Uuid
  
  extWarrantyExpMilesLease Int?
  extWarrantyTermLease     Int?
  insuranceTypeCode        String?
  texasGAPInsuranceAmount  Decimal? @db.Decimal(12, 2)
  
  // Insurance 1-3 stored as JSON for flexibility
  insurance1               Json? // {cost, fee, income, deductible, limit, limitMiles, name, term, unemploymentInsuranceFlag?}
  insurance2               Json?
  insurance3               Json?
  
  // Accidental Health Insurance
  ahiCost                  Decimal? @db.Decimal(12, 2)
  ahiIncome                Decimal? @db.Decimal(12, 2)
  ahiMonthlyMaxAmount      Decimal? @db.Decimal(12, 2)
  ahiPremium               Decimal? @db.Decimal(12, 2)
  ahiRate                  Decimal? @db.Decimal(8, 4)
  ahiTerm                  Int?
  
  // Credit Life Insurance
  cliCost                  Decimal? @db.Decimal(12, 2)
  cliIncome                Decimal? @db.Decimal(12, 2)
  cliMonthlyMaxAmount      Decimal? @db.Decimal(12, 2)
  cliPremium               Decimal? @db.Decimal(12, 2)
  cliRate                  Decimal? @db.Decimal(8, 4)
  cliTerm                  Int?
  cliInsuranceType         String?
  
  // Mechanical Breakdown Insurance
  mbiCarrier               String?
  mbiCost                  Decimal? @db.Decimal(12, 2)
  mbiDeductible            Decimal? @db.Decimal(12, 2)
